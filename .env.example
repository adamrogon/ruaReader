# Copy to .env and fill in. NEVER commit .env.
#
# Mailbox passwords are referenced from config/mailboxes.yml by the name of the
# env var, e.g. `password_env: RUA_MAIN_PASSWORD`. That keeps credentials out of
# both the code and the config files.

PROJECT_ID=linkhouse

# Where SQLite lives and where raw report XML is archived.
DATABASE_URL=sqlite:///data/deliverability.db
ARCHIVE_DIR=data/archive

# Salt for hashing bounce recipient addresses. Set to a long random string and
# keep it stable — changing it makes previously stored hashes non-comparable.
RECIPIENT_HASH_SALT=change-me-to-a-long-random-string

# --- Mailbox credentials -----------------------------------------------------
# One env var per mailbox listed in config/mailboxes.yml.

# Module 1 — mailbox(es) receiving DMARC rua reports
RUA_MAIN_PASSWORD=

# Module 3 — sending mailboxes that receive bounces/NDRs
BOUNCE_DOMAIN1_PASSWORD=
BOUNCE_DOMAIN2_PASSWORD=
